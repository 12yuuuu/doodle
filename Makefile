####### Compile

bullet.o: bullet.cpp Bullet.h \
		Game.h \
		player.h \
		platform.h \
		game.h \
		monster.h \
		score.h \
		item.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o bullet.o bullet.cpp

game.o: game.cpp Game.h \
		player.h \
		platform.h \
		game.h \
		monster.h \
		score.h \
		item.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o game.o game.cpp

item.o: item.cpp item.h \
		player.h \
		platform.h \
		game.h \
		monster.h \
		score.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o item.o item.cpp

main.o: main.cpp game.h \
		player.h \
		platform.h \
		monster.h \
		score.h \
		item.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o main.cpp

monster.o: monster.cpp monster.h \
		player.h \
		platform.h \
		game.h \
		score.h \
		item.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o monster.o monster.cpp

platform.o: platform.cpp game.h \
		player.h \
		platform.h \
		monster.h \
		score.h \
		item.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o platform.o platform.cpp

player.o: player.cpp Player.h \
		platform.h \
		player.h \
		score.h \
		item.h \
		game.h \
		monster.h \
		Bullet.h \
		Game.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o player.o player.cpp

score.o: score.cpp score.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o score.o score.cpp

moc_bullet.o: moc_bullet.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_bullet.o moc_bullet.cpp

moc_item.o: moc_item.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_item.o moc_item.cpp

moc_monster.o: moc_monster.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_monster.o moc_monster.cpp

moc_platform.o: moc_platform.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_platform.o moc_platform.cpp

moc_player.o: moc_player.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_player.o moc_player.cpp

