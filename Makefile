compiler_moc_predefs_make_all: moc_predefs.h
compiler_moc_predefs_clean:
	-$(DEL_FILE) moc_predefs.h
moc_predefs.h: /usr/lib/qt5/mkspecs/features/data/dummy.cpp
	g++ -fno-keep-inline-dllexport -D_GNU_SOURCE -pipe -O2 -Wall -W -dM -E -o moc_predefs.h /usr/lib/qt5/mkspecs/features/data/dummy.cpp

compiler_moc_header_make_all: moc_bullet.cpp moc_item.cpp moc_monster.cpp moc_platform.cpp moc_player.cpp
compiler_moc_header_clean:
	-$(DEL_FILE) moc_bullet.cpp moc_item.cpp moc_monster.cpp moc_platform.cpp moc_player.cpp
moc_bullet.cpp: Game.h \
		player.h \
		platform.h \
		game.h \
